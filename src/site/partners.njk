{#- Partners (since the client review of 27 October 2026, plan 2026-11-05 Task 6): the partner network.
    Who we work with, in the three groups of src/site/_data/partners.json, each logo with its name
    printed under it (so the picture's alt is empty). The ways to partner moved to /partner-with-us/;
    the script below hands an old link to one of them (/partners/#programmes) on there. -#}
<script>if (/^#(laboratories|programmes|funders|how-it-starts|start)$/.test(location.hash)) location.replace('/partner-with-us/' + location.hash);</script>
{%- for g in groups %}
{%- set logos = partners.logos | where("group", g.id) | where("published", true) %}

  <section id="{{ g.id }}" class="section{{ ' bg-paper' if loop.index == 2 }}" aria-labelledby="{{ g.id }}-h">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="{{ g.id }}-h" class="h2 lg:col-span-7">{{ g.h2 | safe }}</h2>
        <p class="lead lg:col-span-5">{{ g.lead }}</p>
      </div>
      <ul class="register mt-12" style="--cols: {{ 4 if logos.length > 4 else logos.length }}">
        {%- for p in logos %}
        <li><span class="register-logo"><img src="/assets/logo/partners/{{ p.file }}" width="{{ p.width }}" height="{{ p.height }}" alt="" style="--ratio: {{ (p.width / p.height) | round(3) }}" loading="lazy" decoding="async"></span><span class="register-name">{{ p.name }}</span></li>
        {%- endfor %}
      </ul>
    </div>
  </section>
{%- endfor %}
