{%- from "picture.njk" import picture with context %}
{%- set arrow = '<svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 6h15M11 1l5 5-5 5"/></svg>' %}

  <!-- 2. The method: the poster's six pictures, the read-out large -->
  <section id="method" class="section bg-paper" aria-labelledby="method-h">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="method-h" class="h2 lg:col-span-7">The method. <span class="h-mark">Six steps, nothing hidden.</span></h2>
        <p class="lead lg:col-span-5">Mutation-specific PCR and agarose gel electrophoresis, methods taught in every molecular biology course. What we invented is how they work together on a dried spot.</p>
      </div>
      <div class="method mt-12">
        <!-- [html-validate-disable-next no-redundant-role, prefer-native-element: preflight's list-style: none drops the list role in Safari/VoiceOver] -->
        <ol role="list" class="method-steps">
          {%- set steps = [
            { title: "Spot", body: "A finger-prick sample is spotted on a barcoded card and dried.", alt: "A finger pricked with a lancet, and a drop of blood going to the circle on a barcoded dried blood spot card." },
            { title: "Punch", body: "A small disc is punched from the spot into a PCR tube.", alt: "A hand punch taking a disc from the dried spot into a PCR tube." },
            { title: "Mix", body: "A ready reaction mix specific to the mutation is added.", alt: "The two LitLife™ reagent tubes, a pipette adding mix to the PCR tube, and a strand of DNA with the mutation marked." },
            { title: "Amplify", body: "PCR runs in a standard thermal cycler, many cards in one run.", alt: "A gloved hand loading a 96-well plate into an open thermal cycler." },
            { title: "Separate", body: "The product is run on an agarose gel.", alt: "A rack of tubes beside an agarose gel electrophoresis tank, a pipette loading the gel." }
          ] %}
          {%- for step in steps %}
          <li>
            {{ picture("work-method-" + loop.index, step.alt, "(min-width: 64rem) 18vw, (min-width: 40rem) 30vw, 92vw", { class: "method-img" }) }}
            <h3><span class="sr-only">Step {{ loop.index }}: </span>{{ step.title }}</h3>
            <p>{{ step.body }}</p>
          </li>
          {%- endfor %}
        </ol>
        <figure class="method-read">
          {{ picture("work-method-6", "An agarose gel read-out with five lanes labelled Marker, Patient, Normal, Carrier and NTC: the patient's lane shows two bands, the normal and the carrier lanes their own patterns, the no-template control none.", "(min-width: 64rem) 38vw, 92vw", { class: "method-gel" }) }}
          <figcaption>
            <h3><span class="sr-only">Step 6: </span>Read</h3>
            <p>Bands show the result: unaffected, carrier or patient, in one run.</p>
            <details class="method-controls">
              <summary>{% icon "list-checks" %}<span>The controls on every run</span>{% icon "chevron-down" %}</summary>
              <ul>
                <li><b>Marker:</b> a DNA ladder, to size each band.</li>
                <li><b>Normal and carrier:</b> known samples beside the patient's, so each result is read against both.</li>
                <li><b>No-template control (NTC):</b> no DNA, so any band would show contamination.</li>
              </ul>
            </details>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 3. Compared: the poster's table -->
  <section id="compared" class="section" aria-labelledby="compared-h">
    <div class="wrap">
      <div class="section-head grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="compared-h" class="h2 lg:col-span-7">Compared. <span class="h-mark">One test where there were two.</span></h2>
        <p class="lead lg:col-span-5">How <span class="whitespace-nowrap">LitLife™</span> compares with the screening and confirmatory tests a programme would otherwise use.</p>
      </div>
      <table class="compare-table mt-12" aria-labelledby="compared-h">
        <caption>From our presentation to the haematology community, October 2026.</caption>
        <thead>
          <tr>
            <td></td>
            <th scope="col">Existing screening tests</th>
            <th scope="col">Existing confirmatory tests</th>
            <th scope="col" class="is-ours">LitLife™</th>
          </tr>
        </thead>
        <tbody>
          {%- set compared = [
            ["Sample", "20 to 50 µl of blood", "1 to 2 ml of EDTA blood", "A spot of blood on a card"],
            ["Collection", "Finger prick", "Venepuncture", "Finger prick"],
            ["Storage and transport", "Cold chain", "Cold chain", "Room temperature"],
            ["Pre-processing", "Yes", "Yes", "None"],
            ["Throughput", "Low", "Low", "High"],
            ["A second test to confirm", "Yes", "No", "No"],
            ["Adults", "Yes", "Yes", "Yes"],
            ["Newborns", "No", "After 72 hours of birth", "At birth"],
            ["Specificity", "Low", "99 to 100%", "100%"],
            ["Sensitivity", "Low", "99 to 100%", "100%"]
          ] %}
          {%- for row in compared %}
          <tr>
            <th scope="row">{{ row[0] }}</th>
            <td data-label="Existing screening tests">{{ row[1] }}</td>
            <td data-label="Existing confirmatory tests">{{ row[2] }}</td>
            <td data-label="LitLife™" class="is-ours">{{ row[3] }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 4. What your laboratory needs -->
  <section id="laboratory" class="section bg-paper" aria-labelledby="laboratory-h">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="laboratory-h" class="h2 lg:col-span-7">What your laboratory needs. <span class="h-mark">If you run PCR today, you can run LitLife™.</span></h2>
        <p class="lead lg:col-span-5">The equipment of a district or hospital laboratory, not a genetics institute.</p>
      </div>
      <dl class="lab-needs mt-12">
        {%- for row in [
          { icon: "microscope", term: "Equipment", def: "A thermal cycler, a gel electrophoresis tank and a card punch." },
          { icon: "flask-conical", term: "DNA extraction", def: "None. A disc from the card goes straight into the reaction." },
          { icon: "thermometer", term: "Samples", def: "Cards keep and travel at room temperature. No cold chain." },
          { icon: "layers", term: "Throughput", def: "High: many cards in one run." },
          { icon: "timer", term: "Time to result", def: "In the technical dossier.", dossier: true },
          { icon: "package", term: "Storage and shelf life", def: "In the technical dossier.", dossier: true },
          { icon: "graduation-cap", term: "People", def: "Staff who have run PCR before, or who have been trained. We train them." },
          { icon: "smartphone", term: "Monitoring", def: "Test details are captured on a mobile app at the point of collection, so a programme can follow its screening as it happens." }
        ] %}
        <div{% if row.dossier %} class="is-dossier"{% endif %}>
          <dt><span class="icon-tile">{% icon row.icon %}</span>{{ row.term }}</dt>
          <dd>{% if row.dossier %}<a class="link" href="#documents">{{ row.def }}</a>{% else %}{{ row.def }}{% endif %}</dd>
        </div>
        {%- endfor %}
      </dl>
    </div>
  </section>

  <!-- 5. Approved, patented, published -->
  <section id="approvals" class="section" aria-labelledby="approvals-h">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="approvals-h" class="h2 lg:col-span-7">Approved, patented, <span class="h-mark">published.</span></h2>
        <p class="lead lg:col-span-5">The evidence a hospital's purchase team and a programme's technical committee ask for.</p>
