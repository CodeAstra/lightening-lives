          <a class="btn btn-line mt-8" href="mailto:{{ site.email }}?subject=Technical%20dossier%20request">Request the documents</a>
        </div>
        <ul class="doc-list">
          <li><span class="doc-icon">{% icon "file-text" %}</span><span><b>Instructions for use</b><small>How to run the test, step by step</small></span><span class="doc-tag">On request</span></li>
          <li><span class="doc-icon">{% icon "file-text" %}</span><span><b>Product sheet</b><small>Each test, what it detects and what comes with it</small></span><span class="doc-tag">On request</span></li>
          <li><span class="doc-icon">{% icon "file-check" %}</span><span><b>Validation summary</b><small>How the test was validated, and against what</small></span><span class="doc-tag">On request</span></li>
        </ul>
      </div>
    </div>
  </section>
