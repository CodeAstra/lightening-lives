    columns say it), REASSURED (one copy, on home) and the card. Brackets never render. -#}
{%- from "picture.njk" import picture with context %}
{%- from "gel.njk" import gelDrawing %}
{%- set arrow = '<svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 6h15M11 1l5 5-5 5"/></svg>' %}

  <!-- 2. The method: the poster's six pictures, the read-out large -->
  <section id="method" class="section bg-paper" aria-labelledby="method-h">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="method-h" class="h2 lg:col-span-7">The six-step method. <span class="h-mark">Nothing hidden.</span></h2>
        <p class="lead lg:col-span-5">Textbook PCR and agarose gel electrophoresis. Our patented innovation lets them work directly on a raw dried blood spot, with no DNA extraction.</p>
      </div>
      <div class="method mt-12">
        <!-- [html-validate-disable-next no-redundant-role, prefer-native-element: preflight's list-style: none drops the list role in Safari/VoiceOver] -->
        <ol role="list" class="method-steps">
          {%- set steps = [
            { title: "Spot", body: "A finger-prick sample is spotted on a barcoded card and dried.", alt: "A finger pricked with a lancet, and a drop of blood going to the circle on a barcoded dried blood spot card." },
            { title: "Punch", body: "A small disc is punched from the spot into a PCR tube.", alt: "A hand punch taking a disc from the dried spot into a PCR tube." },
            { title: "Mix", body: "A ready reaction mix specific to the mutation is added.", alt: "The two LitLife™ reagent tubes, a pipette adding mix to the PCR tube, and a strand of DNA with the mutation marked." },
            { title: "Amplify", body: "PCR runs in a standard thermal cycler, many cards in one run.", alt: "A gloved hand loading a 96-well plate into an open thermal cycler." },
            { title: "Separate", body: "The product is run on an agarose gel.", alt: "A rack of tubes beside an agarose gel electrophoresis tank, a pipette loading the gel." }
          ] %}
          {%- for step in steps %}
          <li>
            {{ picture("work-method-" + loop.index, step.alt, "(min-width: 64rem) 18vw, (min-width: 40rem) 30vw, 92vw", { class: "method-img" }) }}
            <h3><span class="sr-only">Step {{ loop.index }}: </span>{{ step.title }}</h3>
            <p>{{ step.body }}</p>
          </li>
          {%- endfor %}
        </ol>
        {#- Step 6 is the drawn gel the home page uses (client review, 5 November 2026: the poster's photo
            "is not clear"), each sample's lane lit from its key. -#}
        <figure class="method-read gel" data-gel>
          {{ gelDrawing() }}
          <figcaption>
            <h3><span class="sr-only">Step 6: </span>Read and report</h3>
            <p>Bands read as patient, carrier or unaffected, and the result is reported the same day.</p>
            <details class="method-controls">
              <summary>{% icon "list-checks" %}<span>The controls on every run</span>{% icon "chevron-down" %}</summary>
              <ul>
                <li><b>Marker:</b> a DNA ladder, to size each band.</li>
                <li><b>Normal and carrier:</b> known samples beside the patient's, so each result is read against both.</li>
                <li><b>No-template control (NTC):</b> the lane marked Control. It has no DNA, so any band would show contamination.</li>
              </ul>
            </details>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 3. Compared: the poster's table -->
  <section id="compared" class="section" aria-labelledby="compared-h">
    <div class="wrap">
      <div class="section-head grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="compared-h" class="h2 lg:col-span-7">Compared. <span class="h-mark">One test where there were two.</span></h2>
        <p class="lead lg:col-span-5">Stop choosing between cheap, inaccurate screening and costly, complex confirmation. <span class="whitespace-nowrap">LitLife™</span> replaces both in a single step.</p>
      </div>
      <table class="compare-table mt-12" aria-labelledby="compared-h">
        <caption>Data: our presentation to the haematology community, October 2026.</caption>
        <thead>
          <tr>
            <td></td>
            <th scope="col">Existing screening tests</th>
            <th scope="col">Existing confirmatory tests</th>
            <th scope="col" class="is-ours">LitLife™</th>
          </tr>
        </thead>
        <tbody>
          {%- set compared = [
            ["Sample", "20 to 50 µl of blood", "1 to 2 ml of EDTA blood", "A spot of blood on a card"],
            ["Collection", "Finger prick", "Venepuncture", "Finger or heel prick"],
            ["Storage and transport", "Cold chain", "Cold chain", "Room temperature, no cold chain"],
            ["Pre-processing", "Yes", "Yes", "None: direct to PCR"],
            ["Throughput", "Low", "Low", "High: scalable for mass screening"],
            ["A second test to confirm", "Yes", "No", "No: screens and confirms in one go"],
            ["Adults", "Yes", "Yes", "Yes"],
            ["Newborns", "No", "After 72 hours of birth", "Yes, at birth"],
            ["Specificity", "Low", "99 to 100%", "100%"],
            ["Sensitivity", "Low", "99 to 100%", "100%"]
          ] %}
          {%- for row in compared %}
          <tr>
            <th scope="row">{{ row[0] }}</th>
            <td data-label="Existing screening tests">{{ row[1] }}</td>
            <td data-label="Existing confirmatory tests">{{ row[2] }}</td>
            <td data-label="LitLife™" class="is-ours">{{ row[3] }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 4. What your laboratory needs -->
  <section id="laboratory" class="section bg-paper" aria-labelledby="laboratory-h">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="laboratory-h" class="h2 lg:col-span-7">If you run PCR today, <span class="h-mark">you can run LitLife™.</span></h2>
        <p class="lead lg:col-span-5">Built for everyday diagnostic labs and hospitals, not only genetics institutes. Use the equipment you already own.</p>
      </div>
      <dl class="lab-needs mt-12">
        {%- for row in [
          { icon: "microscope", term: "Equipment needed", def: "A thermal cycler, a gel electrophoresis tank and a card punch. No proprietary system." },
          { icon: "flask-conical", term: "DNA extraction", def: "None. A disc from the card goes straight into the reaction." },
          { icon: "thermometer", term: "Sample logistics", def: "Cards keep and travel at room temperature. Zero cold chain." },
          { icon: "layers", term: "Throughput", def: "High. Many cards in a single run, for mass screening." },
          { icon: "timer", term: "Time to result", def: "Same-day turnaround.", link: "Full protocol timing in the technical dossier.", dossier: true },
          { icon: "package", term: "Storage and shelf life", def: "Long-term stability for dried samples and kits.", link: "Full data in the technical dossier.", dossier: true },
          { icon: "graduation-cap", term: "Staff and training", def: "Any technician who has run basic PCR. We provide hands-on training and certification." },
          { icon: "scan-barcode", term: "Monitoring", def: "Every card is barcoded, so each sample can be followed from collection to report." }
        ] %}
        <div{% if row.dossier %} class="is-dossier"{% endif %}>
          <dt><span class="icon-tile">{% icon row.icon %}</span>{{ row.term }}</dt>
          <dd>{{ row.def }}{% if row.dossier %} <a class="link" href="#documents">{{ row.link }}</a>{% endif %}</dd>
        </div>
        {%- endfor %}
      </dl>
    </div>
  </section>

  <!-- 5. Approved, patented, published -->
  <section id="approvals" class="section" aria-labelledby="approvals-h">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <h2 id="approvals-h" class="h2 lg:col-span-7">Approved. Patented. <span class="h-mark">Published.</span></h2>
        <p class="lead lg:col-span-5">The clinical and regulatory evidence that hospital purchase committees, NABL-accredited labs and government technical bodies ask for.</p>
      </div>
      <ul class="approvals mt-12" id="patents">
        <li>
          <span class="approval-mark">{% icon "badge-check" %}</span>
          <h3>ICMR approved</h3>
          <p>LitLife™-SCA, validated by ICMR with 100% sensitivity and specificity for sickle cell anaemia.</p>
        </li>
        <li>
          <span class="approval-mark">{% icon "award" %}</span>
          <h3>Patents granted in India and Japan</h3>
          <p>For the technology behind our dried blood spot tests.</p>
        </li>
        <li>
          <span class="approval-mark">{% icon "globe" %}</span>
          <h3>A globally published patent</h3>
          <p>The method is published internationally.</p>
        </li>
        <li>
          <span class="approval-mark">{% icon "landmark" %}</span>
          <h3>Built on CSIR-CCMB know-how</h3>
          <p>An MOU with the CSIR-Centre for Cellular and Molecular Biology, Hyderabad, covers developing and commercialising the sickle cell assay.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- 6. Documents, on request -->
  <section id="documents" class="section bg-paper" aria-labelledby="documents-h">
    <div class="wrap">
      <div class="documents">
        <div>
          <h2 id="documents-h" class="h2">The technical dossier. <span class="h-mark">On request.</span></h2>
          <p class="lead mt-5">Instructions for use, the product sheet and the validation summary, in one dossier for your laboratory or procurement team.</p>
          <a class="btn btn-line mt-8" {{ { topic: "dossier" } | enquire | safe }}>Request the technical dossier</a>
        </div>
        <ul class="doc-list">
          <li><span class="doc-icon">{% icon "file-text" %}</span><span><b>Instructions for use</b><small>How to run the test, step by step</small></span><span class="doc-tag">On request</span></li>
          <li><span class="doc-icon">{% icon "file-text" %}</span><span><b>Product sheet</b><small>Each test, what it detects and what comes with it</small></span><span class="doc-tag">On request</span></li>
          <li><span class="doc-icon">{% icon "file-check" %}</span><span><b>Validation summary</b><small>How the test was validated, and against what</small></span><span class="doc-tag">On request</span></li>
        </ul>
      </div>
    </div>
  </section>
