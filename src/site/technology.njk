  <!-- The card: the drawn card (the photographs in content/assets/kit-reference-* are internal) -->
  <section id="card" class="section" aria-labelledby="card-h">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16 lg:items-center">
      <div class="lg:col-span-7">
        <h2 id="card-h" class="h2">A card made for the field</h2>
        <p class="mt-6 max-w-[38rem] text-moss">The card opens like a matchbook. Its cover carries our logo and protects the sample. Inside, a circle on filter paper shows where the spot goes. A barcode and a code identify each card, and the back has room for the person's name, age, sex and the date.</p>
