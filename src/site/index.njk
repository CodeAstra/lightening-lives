  <!-- Who we work with -->
  <section id="partners" class="section bg-paper" aria-labelledby="partners-h">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <h2 id="partners-h" class="h2 lg:col-span-7">We work with institutions</h2>
        <p class="lead lg:col-span-5">Hospitals, laboratories and public health programmes bring us a condition to screen for or diagnose. Most of that work begins as a collaboration.</p>
      </div>
      <ul class="audiences mt-12">
        <li>
          <h3 class="h3">Hospitals, laboratories and clinicians</h3>
          <p>Genetic tests for inherited blood and muscle conditions, designed to run with minimal laboratory infrastructure. We help set the method up and train your staff.</p>
        </li>
        <li>
          <h3 class="h3">District health officers and government programmes</h3>
          <p>Tests developed for national health programmes, for screening at population scale, with counselling and follow-up alongside.</p>
        </li>
        <li>
          <h3 class="h3">NGOs and CSR funders</h3>
          <p>A partner for large, population-level screening: the testing, the method for the field, and support for the families it identifies.</p>
        </li>
      </ul>
      <a class="link mt-8" href="/partnerships/#how-it-starts">How a collaboration works
        {{ arrow | safe }}
      </a>
      <div class="mt-12">
        {% include "notice.njk" %}
      </div>
    </div>
  </section>

