    <div class="hero-frame" data-frame></div>

    <div class="hero-text" data-hero-text>
      <h1 id="hero-h" class="display rise" style="--i:0">Genetic testing from a spot of blood on a card.</h1>
      <p class="hero-lead lead rise" style="--i:1">We develop genetic tests for inherited blood and muscle conditions, built for hospitals, laboratories and public health programmes.</p>
      <div class="hero-actions rise" style="--i:2">
        <a class="btn btn-solid" href="{{ site.cta.href }}">{{ site.cta.text }}</a>
