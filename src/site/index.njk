        <svg class="i-play" aria-hidden="true" width="12" height="14" viewBox="0 0 14 16" fill="currentColor"><path d="M2 1.2v13.6a.6.6 0 0 0 .92.5l10.7-6.8a.6.6 0 0 0 0-1L2.92.7A.6.6 0 0 0 2 1.2Z"/></svg>
        <svg class="i-replay" aria-hidden="true" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.2 9a5.8 5.8 0 1 0 1.9-4.3"/><path d="M2.6 1.9v3.6h3.6"/></svg>
