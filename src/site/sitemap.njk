---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
{#- Every public page (publicPages: drafts are never built; the 404 page and the preview cards are not
    pages of their own address), with the day its source last changed. -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.publicPages %}
  <url>
    <loc>{{ site.domain }}{{ item.url }}</loc>
    <lastmod>{{ item.date | isoDay }}</lastmod>
  </url>
{%- endfor %}
</urlset>
