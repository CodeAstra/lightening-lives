  <!-- In development -->
  <section id="in-development" class="section bg-paper" aria-labelledby="in-development-h">
    <div class="wrap">
      <h2 id="in-development-h" class="h2 max-w-[44rem]">In development</h2>
      <ul class="rows mt-10">
        <li>
          <h3>Blood coagulation panel</h3>
          <p>Genetic testing for inherited bleeding disorders such as haemophilia: confirming a diagnosis, identifying carriers, and supporting family counselling and care planning.</p>
        </li>
        <li>
          <h3>Pharmacogenomics</h3>
          <p>How a person's genes change their response to a medicine, so that the drug and the dose can be chosen for the person.</p>
        </li>
      </ul>
      <p class="mt-6">
        {{ pageLink("/solutions/develop-a-test/#in-development", "Ask about a test in development") }}
      </p>
