{#- REASSURED (content file 5.1): the word as nine buttons over the nine criteria, each with its icon,
    in the poster's words (src/site/_data/reassuredCopy.json; 25 October 2026, "one drop of blood" reworded).
    Each criterion is led by its letter, large; the source line went at the user's request (25 October 2026). A page that includes it may set, before the
    include, reassured = { surface: "bg-paper", after: "a sentence under it" }: the band's surface,
    where the page's order of bands needs paper (DESIGN.md, Layout), and 5.2's body under it. -#}
<section id="reassured" class="section{% if reassured and reassured.surface %} {{ reassured.surface }}{% endif %}" aria-labelledby="reassured-h">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
      <h2 id="reassured-h" class="h2 lg:col-span-7">{{ reassuredCopy.h2 | safe }}</h2>
      <p class="lead lg:col-span-5">{{ reassuredCopy.lead }}</p>
    </div>

    <div class="word mt-12" role="group" aria-label="REASSURED, one letter for each criterion" data-word>
      {%- for c in reassuredCopy.items %}
      <button type="button" aria-label="{{ c.letter }}: {{ c.name }}">{{ c.letter }}</button>
      {%- endfor %}
    </div>

    <ol class="criteria mt-10" data-criteria>
      {%- for c in reassuredCopy.items %}
      <li><span class="crit-letter" aria-hidden="true">{{ c.letter }}</span><div><h3><span class="crit-name">{{ c.name | replace("-", "‑") }}</span><span class="crit-icon">{% icon c.icon %}</span></h3><p>{{ c.line }}</p></div></li>
      {%- endfor %}
    </ol>
    {%- if reassured and reassured.after %}
    <p class="reassured-after">{{ reassured.after }}</p>
    {%- endif %}
  </div>
</section>
