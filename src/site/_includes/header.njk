{#- The header lies over the top of the page and stays at the top as it scrolls. Below 64rem the links
    move into the Menu panel, a <details> that works without script. A link is marked current when the
    page is in its section. Solutions opens a panel of its own (content 3.2, 25 October 2026), also a
    <details>: the tests by family, what is in development, all solutions and Develop a test. -#}
{%- set arrow = '<svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 6h15M11 1l5 5-5 5"/></svg>' -%}
<header class="site-header">
  <a href="/" class="brand" aria-label="{{ site.name }} home">
    <img class="brand-mark" src="/assets/logo/lightening-lives-emblem.svg" alt="" width="60" height="60">
    <span class="brand-text"><span class="brand-name">{{ site.name }}</span><span class="brand-line">{{ site.tagline }}</span></span>
  </a>
  <nav class="site-nav" aria-label="Main">
    {%- for link in site.nav %}
    {%- if link.menu %}
    <details class="nav-drop" data-nav-drop>
      <summary class="nav-link{% if page.url.startsWith(link.href) %} is-current{% endif %}">{{ link.text }}{% icon "chevron-down" %}</summary>
      <div class="nav-drop-panel">
        <div class="nav-drop-groups">
          {%- for group in link.menu.groups %}
          <div class="nav-drop-group">
            <p class="nav-drop-h"><span class="icon-tile">{% icon group.icon %}</span>{{ group.name }}</p>
            <ul>
              {%- for item in group.links %}
              <li><a class="nav-drop-link" href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}><span>{{ item.text }}</span><small>{{ item.code }}</small></a></li>
              {%- endfor %}
            </ul>
          </div>
          {%- endfor %}
        </div>
        <div class="nav-drop-foot">
          <p>{% icon "flask-conical" %}{{ link.menu.note }}</p>
          <ul>
            {%- for item in link.menu.more %}
            <li><a class="link" href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.text }} {{ arrow | safe }}</a></li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </details>
    {%- else %}
    <a class="nav-link" href="{{ link.href }}"{% if page.url.startsWith(link.href) %} aria-current="page"{% endif %}>{{ link.text }}</a>
    {%- endif %}
    {%- endfor %}
    <a class="btn btn-solid ml-3" href="{{ site.cta.href }}"{% if page.url.startsWith(site.cta.href) %} aria-current="page"{% endif %}>{{ site.cta.text }}</a>
  </nav>
  <details class="menu" data-menu>
    <summary class="btn btn-line bg-mist" aria-label="Menu"><span class="menu-open">Menu</span><span class="menu-close">Close</span></summary>
    <nav class="menu-panel" aria-label="Main (mobile)">
      <ul class="grid gap-0.5">
        {%- for link in site.nav %}
        <li><a class="nav-link" href="{{ link.href }}"{% if page.url.startsWith(link.href) %} aria-current="page"{% endif %}>{{ link.text }}</a>
          {%- if link.menu %}
          <ul class="menu-sub">
            {%- for group in link.menu.groups %}{% for item in group.links %}
            <li><a class="nav-link" href="{{ item.href }}">{{ item.text }}</a></li>
            {%- endfor %}{% endfor %}
            <li><a class="nav-link" href="{{ link.menu.more[1].href }}">{{ link.menu.more[1].text }}</a></li>
          </ul>
          {%- endif %}
        </li>
        {%- endfor %}
        <li class="pt-2"><a class="btn btn-solid w-full" href="{{ site.cta.href }}"{% if page.url.startsWith(site.cta.href) %} aria-current="page"{% endif %}>{{ site.cta.text }}</a></li>
      </ul>
    </nav>
  </details>
</header>
