{#- The full logo once, at 11rem; the company in a line; its pages in two columns; how to reach it; its
    two addresses; then, under a hairline, the small print. On a wide screen the logo's column spans
    both rows, so the addresses sit under the links. -#}
<footer class="site-footer">
  <div class="wrap py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
      <div class="sm:col-span-2 lg:col-span-4 lg:row-span-2">
        <img src="/assets/logo/lightening-lives-logo.svg" alt="{{ site.name }}, {{ site.tagline }}" width="176" height="176" class="h-44 w-44" loading="lazy">
        <p class="mt-3 max-w-[22rem] text-moss">{{ site.about }}</p>
        <p class="label mt-4">{{ site.words }}</p>
      </div>
      <nav class="lg:col-span-2" aria-label="What we do">
        <p class="label">What we do</p>
        <ul class="mt-1">
          {%- for link in site.footer.whatWeDo %}
          <li><a class="foot-link" href="{{ link.href }}">{{ link.text }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <nav class="lg:col-span-2" aria-label="Company">
        <p class="label">Company</p>
        <ul class="mt-1">
          {%- for link in site.footer.company %}
          <li><a class="foot-link" href="{{ link.href }}">{{ link.text }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <div class="sm:col-span-2 lg:col-span-4">
        <p class="label">Contact</p>
        <ul class="mt-1">
          <li><a class="foot-link break-all" href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a class="foot-link" href="tel:{{ site.tel }}">{{ site.phone | replace(" ", "&nbsp;") | safe }}</a>{% if site.whatsapp %} <span class="text-moss">(call or WhatsApp)</span>{% endif %}</li>
          {%- for account in site.social %}
          <li><a class="foot-link" href="{{ account.href }}" rel="noopener">{{ account.text }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- for key, address in site.addresses %}
      <div class="lg:col-span-4">
        <p class="label">{{ address.label }}</p>
        <address class="mt-2 not-italic">{{ address.street }}, {{ address.locality }}, {{ address.region }} {{ address.postcode }}</address>
      </div>
      {%- endfor %}
    </div>

    <div class="mt-12 grid gap-6 border-t border-line pt-6 text-[1rem] text-moss lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p>{{ site.footer.disclaimer }}</p>
        <p class="mt-2">{{ site.footer.trademark }}</p>
        <details class="credits mt-2">
          <summary class="foot-link text-canopy">Photo and map credits</summary>
          <ul class="mt-1 grid gap-1 text-[0.9375rem]">
            <li>Toranmal, Nandurbar: <a href="https://commons.wikimedia.org/wiki/File:Toranmal-Nandurbar.jpg" rel="noopener">HongYu HenzaiSuru</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener license">CC BY-SA 4.0</a>.</li>
            <li>Kinnerasani reservoir, Kothagudem: <a href="https://commons.wikimedia.org/wiki/File:Kinnarsani_Dam_02.JPG" rel="noopener">Pranayraj1985</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener license">CC BY-SA 4.0</a> (cropped).</li>
            <li>Patratu Valley, Jharkhand: <a href="https://commons.wikimedia.org/wiki/File:Patratu_valley.jpg" rel="noopener">TribhuwanKumar</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener license">CC BY-SA 4.0</a> (cropped).</li>
            <li>Map outline and state boundaries: <a href="https://github.com/datameet/maps" rel="noopener">DataMeet India community</a>, <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener license">CC BY 4.0</a> (simplified to a grid).</li>
          </ul>
        </details>
      </div>
      <div class="lg:col-span-5 lg:text-right">
        <p>© 2026 {{ site.legalName }}</p>
        <p class="flex items-center gap-x-2 lg:justify-end">
          {%- for link in site.footer.policies %}
          {%- if not loop.first %}<span aria-hidden="true">·</span>{% endif %}<a class="foot-link text-canopy" href="{{ link.href }}">{{ link.text }}</a>
          {%- endfor %}
        </p>
      </div>
    </div>
  </div>
</footer>
