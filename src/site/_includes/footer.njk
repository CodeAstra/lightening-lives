{#- The footer (25 October 2026, "big and ugly" redone): one compact band. The brand, a line on the
    company and the social marks; three short link groups (solutions, the company's pages, how to
    reach it, with icons); then one bar of small print. The addresses live on Contact. -#}
<footer class="site-footer">
  <div class="wrap foot-wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="/" class="brand" aria-label="{{ site.name }} home">
          <img class="brand-mark" src="/assets/logo/lightening-lives-emblem.svg" alt="" width="60" height="60" loading="lazy">
          <span class="brand-text"><span class="brand-name">{{ site.name }}</span><span class="brand-line">{{ site.tagline }}</span></span>
        </a>
        <p class="foot-about">{{ site.about }}</p>
        <ul class="foot-social">
          {%- for account in site.social %}
          <li><a href="{{ account.href }}" rel="noopener" aria-label="{{ site.name }} on {{ account.text }}">{% brand account.icon %}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <nav class="foot-group" aria-label="Solutions">
        <p class="foot-h">Solutions</p>
        <ul>
          {%- for link in site.footer.solutions %}
          <li><a class="foot-link" href="{{ link.href }}">{{ link.text }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <nav class="foot-group" aria-label="Company">
        <p class="foot-h">Company</p>
        <ul>
          {%- for link in site.footer.whatWeDo %}{% if link.href != "/solutions/" %}
          <li><a class="foot-link" href="{{ link.href }}">{{ link.text }}</a></li>
          {%- endif %}{% endfor %}
          {%- for link in site.footer.company %}{% if link.href != "/contact/" %}
          <li><a class="foot-link" href="{{ link.href }}">{{ link.text }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
      </nav>
      <div class="foot-group foot-contact">
        <p class="foot-h">Contact</p>
        <ul>
          <li><a class="foot-link" href="mailto:{{ site.email }}">{% icon "mail" %}<span class="break-all">{{ site.email }}</span></a></li>
          <li><a class="foot-link" href="tel:{{ site.tel }}">{% icon "phone" %}<span>{{ site.phone | replace(" ", "&nbsp;") | safe }}</span></a></li>
          {%- if site.whatsapp %}
          <li><a class="foot-link" href="https://wa.me/{{ site.tel | replace('+', '') }}" rel="noopener">{% icon "message-circle" %}<span>WhatsApp</span></a></li>
          {%- endif %}
          <li><a class="foot-link" href="/contact/">{% icon "map-pin" %}<span>{{ site.addresses.lab.locality }}, {{ site.addresses.lab.region }}</span></a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bar">
      <p class="foot-fine">© 2026 {{ site.legalName }}. {{ site.footer.trademark }} {{ site.footer.disclaimer }}</p>
      <div class="foot-legal">
        {%- set shown = credits | creditsFor(content) %}
        {%- if shown.length %}
        <details class="credits">
          <summary class="foot-link">Photo and map credits</summary>
          {%- if shown | photographs | length %}
          <p class="mt-1">{{ site.footer.representative }}</p>
          {%- endif %}
          <ul class="mt-1 grid gap-1">
            {%- for row in shown %}
            <li data-credit="{{ row.basename }}">{{ row.label }}: {% if row.authorUrl %}<a href="{{ row.authorUrl }}" rel="noopener">{{ row.author }}</a>{% else %}{{ row.author }}{% endif %}, {% if row.licenceUrl %}<a href="{{ row.licenceUrl }}" rel="noopener">{{ row.licence }}</a>{% else %}{{ row.licence }}{% endif %}, <a href="{{ row.sourceUrl }}" rel="noopener">{{ row.source }}</a>{% if row.changes %} ({{ row.changes }}){% endif %}.</li>
            {%- endfor %}
          </ul>
        </details>
        {%- endif %}
        {%- for link in site.footer.policies %}
        <a class="foot-link" href="{{ link.href }}">{{ link.text }}</a>
        {%- endfor %}
      </div>
    </div>
  </div>
</footer>
