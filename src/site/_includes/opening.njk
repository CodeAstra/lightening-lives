{#- How an inner page opens (content file 4.6; DESIGN.md "Other pages"), in the home page's direction
    since 25 October 2026: on mist, with no label line over the heading (the label stays in the front
    matter, for the breadcrumbs); the h1, which may set its key phrase in DNA blue (one
    <span class="h-mark">, so it is written in the page's own front matter and rendered as markup); the
    lead in the seven-and-five split (or, with stacked, under the heading at full width: About, since
    the client review of 27 October 2026; that review also gave each inner page a kicker, one small
    capitals label over the heading, the user's ruling U2), the lead aligned to the heading's last line; then the page's
    proof with its icons (proof: [{ icon, text }], the home opening's row), its tags (chips, the test
    pages) and up to two buttons (openingActions: [{ text, href, solid }], or { text, topic | who | condition, solid } to open
    the enquiry form). line, where a page has one, sits
    between the lead and the tags (SMA, content 5.6). .section-head is the part that settles in. -#}
{%- from "credentials.njk" import credentials %}
{%- macro opening(label, h1, lead, chips, line, proof, actions, wide, kicker, stacked) %}
<section class="section page-open{{ ' page-open-wide' if wide }}{{ ' page-open-stacked' if stacked }}" aria-labelledby="page-h">
  <div class="wrap">
    <div class="section-head grid gap-6{{ '' if stacked else ' lg:grid-cols-12 lg:items-start' }}">
      <div{% if not stacked %} class="lg:col-span-7"{% endif %}>
        {%- if kicker %}
        <p class="label page-kicker rise" style="--i:0">{{ kicker }}</p>
        {%- endif %}
        <h1 id="page-h" class="display rise" style="--i:0">{{ h1 | unbracket | safe }}</h1>
      </div>
      <div class="{{ 'page-open-rest' if stacked else 'lg:col-span-5' }}">
        {%- if lead | unbracket %}
        <p class="lead rise" style="--i:1">{{ lead | unbracket }}</p>
        {%- endif %}
        {%- if line %}
        <p class="lead-line rise" style="--i:2">{{ line | unbracket }}</p>
        {%- endif %}
        {%- if chips and chips.length %}
        <ul class="tags rise" style="--i:3">
          {%- for chip in chips %}
          <li class="tag{% if chip.proof %} tag-proof{% endif %}">{{ chip.text }}</li>
          {%- endfor %}
        </ul>
        {%- endif %}
        {%- if proof and proof.length %}
        {{ credentials(proof, "page-proof rise", "--i:3") }}
        {%- endif %}
        {%- if actions and actions.length %}
        <div class="page-actions rise" style="--i:4">
          {%- for action in actions %}
          {%- if action.topic or action.who or action.condition %}
          <a class="btn {{ 'btn-solid' if action.solid else 'btn-line' }}" {{ { who: action.who, condition: action.condition, topic: action.topic } | enquire | safe }}>{{ action.text }}</a>
          {%- else %}
          <a class="btn {{ 'btn-solid' if action.solid else 'btn-line' }}" href="{{ action.href }}">{{ action.text }}</a>
          {%- endif %}
          {%- endfor %}
        </div>
        {%- endif %}
      </div>
    </div>
  </div>
</section>
{%- endmacro %}
