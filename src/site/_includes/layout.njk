{%- from "opening.njk" import opening -%}
{#- Every page. An inner page sets title, description, label, h1, lead and chips in its front matter,
    and the layout opens it and closes it with the closing band (closing: false leaves the band out;
    closing: { h2, body, solid, line } replaces its words). The home page sets film: true and writes
    all of its own sections. notice: true adds the notice for individuals. leadLine is a line under
    the lead (SMA's, content 5.6). notFound: true (the 404 page) has no canonical, og:url or breadcrumbs
    and is noindex. Brackets never render: a chip that is only a bracket is left out. -#}
{%- set url = site.domain + page.url -%}
{%- set addresses = [] -%}
{%- for key, a in site.addresses -%}
  {%- set addresses = addresses.concat([{ "@type": "PostalAddress", "name": a.label, "streetAddress": a.street, "addressLocality": a.locality, "addressRegion": a.region, "postalCode": a.postcode, "addressCountry": "IN" }]) -%}
{%- endfor -%}
{%- set organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": site.name,
  "legalName": site.legalName,
  "url": site.domain,
  "logo": site.domain + "/assets/logo/lightening-lives-logo-512.png",
  "slogan": site.tagline,
  "description": site.about,
  "email": site.email,
  "telephone": site.phone,
  "address": addresses
} -%}
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | unbracket }}</title>
<meta name="description" content="{{ description | unbracket }}">
{%- if notFound %}
{#- The Not found page is served at whatever address was asked for: it claims none, and is not indexed. #}
<meta name="robots" content="noindex">
{%- else %}
<link rel="canonical" href="{{ url }}">
{%- endif %}
<meta name="theme-color" content="#F0F9FF">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_IN">
<meta property="og:title" content="{{ title | unbracket }}">
<meta property="og:description" content="{{ description | unbracket }}">
{%- if not notFound %}
<meta property="og:url" content="{{ url }}">
{%- endif %}
{#- Every page but the home page has a card of its own (npm run social); the home page's is the film's end. #}
<meta property="og:image" content="{{ site.domain }}{{ social or ('/assets/img/social.png' if page.url == '/' else '/assets/img/social/' + (page.url | socialSlug) + '.png') }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- if socialAlt %}
<meta property="og:image:alt" content="{{ socialAlt }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/logo/icons/icon-32.png">
<link rel="apple-touch-icon" href="/assets/logo/icons/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{#- The two latin type files (src/css/fonts.css), fetched with the stylesheet rather than after it, so
    the text is set once in its own type and does not move when the type arrives. #}
<link rel="preload" href="/assets/fonts/archivo-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
{%- if film %}
<script>
/* The opening film needs WebGL, and it plays by itself only for a reader who has not asked for reduced
   motion (anyone else is offered a button to start it). Decide before first paint, so the still image
   is never fetched when the film will replace it; back out if the film never arrives. */
(function () {
  var root = document.documentElement;
  if (!window.WebGL2RenderingContext) return;
  root.classList.add('film-can');
  if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  root.classList.add('film-live');
  setTimeout(function () { if (!root.classList.contains('film-ready')) root.classList.remove('film-live'); }, 7000);
})();
</script>
{%- endif %}
{%- if mosaic %}
<script>
/* Our work's photographs develop as the page opens (motion.js). Marked before the first paint, so a
   photograph is never shown and then hidden to be shown again; for a reader who asked for less motion
   nothing is marked. The stylesheet uncovers them by itself after 2.5 s if the script never runs. */
if (!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) document.documentElement.classList.add('mosaic-pending');
</script>
{%- endif %}
<script src="/assets/js/site.js" type="module" defer></script>
{%- set beacon = site.analytics | analytics %}
{%- if beacon %}
<script defer src="{{ beacon.src }}"{% for name, value in beacon.attrs %} {{ name }}='{{ value }}'{% endfor %}></script>
{%- endif %}
<script type="application/ld+json">{{ organization | dump | safe }}</script>
{%- if page.url == "/" %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "WebSite", "name": site.name, "url": site.domain, "inLanguage": "en-IN" } | dump | safe }}</script>
{%- elif not notFound %}
{% include "breadcrumbs.njk" %}
{%- endif %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% include "header.njk" %}
<main id="main">
{%- if not film and not ownOpening %}
{{ opening(label, h1, lead | unbracket, chips | bracketless("text"), leadLine | unbracket, proof, openingActions, openingWide) }}
{%- endif %}
{{ content | safe }}
{%- if not film %}
{%- if closing !== false %}
{% include "closing.njk" %}
{%- elif notice %}
<section class="section notice-band" aria-label="{{ site.notice.label }}">
  <div class="wrap">
    {% include "notice.njk" %}
  </div>
</section>
{%- endif %}
{%- endif %}
</main>
{% include "footer.njk" %}
<script>
/* The header takes a solid ground once the page moves under it. */
(function () {
  var head = document.querySelector('.site-header');
  function stuck() { head.classList.toggle('is-stuck', window.scrollY > 8); }
  addEventListener('scroll', stuck, { passive: true }); stuck();
})();
</script>
</body>
</html>
