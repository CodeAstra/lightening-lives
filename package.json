{
  "name": "lightening-lives",
  "version": "1.0.0",
  "private": true,
  "description": "The Lightening Lives website: Eleventy, Tailwind CSS and esbuild, built to dist/ for GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "pages": "node scripts/build.mjs --pages",
    "deploy": "node scripts/deploy.mjs --domain lightening-lives.codeastra.com",
    "images": "node scripts/images.mjs",
    "stills": "node scripts/stills.mjs",
    "social": "node scripts/social.mjs",
    "sweep": "node scripts/sweep.mjs",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\" \"tests/pages/*.test.mjs\"",
    "kit-stills": "node scripts/kit-stills.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@tailwindcss/cli": "^4.3",
    "cheerio": "^1.1",
    "esbuild": "^0.28",
    "gh-pages": "^6.3.0",
    "gsap": "^3.13",
    "html-validate": "^10",
    "lucide-static": "^1.61.0",
    "photoswipe": "^5.4.4",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3",
    "three": "^0.186"
  }
}
